[Unit]
Description=Serveur de synchronisation Tsundoku
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=tsundoku
EnvironmentFile=/etc/tsundoku-sync.env
WorkingDirectory=/opt/tsundoku-sync
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
# Durcissement : le service n'a besoin que de lire son dossier et de parler à PostgreSQL.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
